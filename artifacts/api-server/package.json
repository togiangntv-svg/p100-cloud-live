{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:ai-gateway": "esbuild ./verification/verify-ai-gateway.ts --bundle --platform=node --format=esm --outfile=/tmp/verify-100-ai-gateway.mjs && node /tmp/verify-100-ai-gateway.mjs",
    "verify:m3-runtime": "esbuild ./verification/verify-m3-runtime.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-100-m3-runtime.cjs && node /tmp/verify-100-m3-runtime.cjs",
    "verify:m3-diagnostics": "esbuild ./verification/verify-m3-diagnostics.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-100-m3-diagnostics.cjs && node /tmp/verify-100-m3-diagnostics.cjs",
    "verify:m3-provider-preflight": "esbuild ./verification/verify-m3-provider-preflight.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-100-m3-provider-preflight.cjs && node /tmp/verify-100-m3-provider-preflight.cjs",
    "verify:m3-browser-fixtures": "esbuild ./verification/verify-m3-browser-fixtures.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-100-m3-browser-fixtures.cjs && node /tmp/verify-100-m3-browser-fixtures.cjs",
    "verify:identity-session": "esbuild ./verification/verify-identity-session.ts --bundle --packages=external --platform=node --format=esm --outfile=./node_modules/.cache/verify-100-identity-session.mjs && node ./node_modules/.cache/verify-100-identity-session.mjs",
    "verify:apple-sign-in": "esbuild ./verification/verify-apple-sign-in.ts --bundle --packages=external --platform=node --format=esm --outfile=./node_modules/.cache/verify-100-apple-sign-in.mjs && node ./node_modules/.cache/verify-100-apple-sign-in.mjs"
  },
  "dependencies": {
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
